{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the Mediamorph window may do",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-set-theme",
    "opener:default",
    "dialog:allow-open",
    "dialog:allow-message",
    "shell:allow-kill",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/ffmpeg",
          "args": true,
          "sidecar": true
        },
        {
          "name": "binaries/ffprobe",
          "args": true,
          "sidecar": true
        },
        {
          "name": "ffmpeg-full",
          "cmd": "/opt/homebrew/opt/ffmpeg-full/bin/ffmpeg",
          "args": true,
          "sidecar": false
        },
        {
          "name": "ffprobe-full",
          "cmd": "/opt/homebrew/opt/ffmpeg-full/bin/ffprobe",
          "args": true,
          "sidecar": false
        },
        {
          "name": "ffmpeg-path",
          "cmd": "ffmpeg",
          "args": true,
          "sidecar": false
        },
        {
          "name": "ffmpeg-homebrew",
          "cmd": "/opt/homebrew/bin/ffmpeg",
          "args": true,
          "sidecar": false
        },
        {
          "name": "ffmpeg-usr-local",
          "cmd": "/usr/local/bin/ffmpeg",
          "args": true,
          "sidecar": false
        },
        {
          "name": "ffprobe-path",
          "cmd": "ffprobe",
          "args": true,
          "sidecar": false
        },
        {
          "name": "ffprobe-homebrew",
          "cmd": "/opt/homebrew/bin/ffprobe",
          "args": true,
          "sidecar": false
        },
        {
          "name": "ffprobe-usr-local",
          "cmd": "/usr/local/bin/ffprobe",
          "args": true,
          "sidecar": false
        },
        {
          "name": "df-bin",
          "cmd": "/bin/df",
          "args": [
            "-k",
            {
              "validator": ".+"
            }
          ],
          "sidecar": false
        }
      ]
    },
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/ffmpeg",
          "args": true,
          "sidecar": true
        },
        {
          "name": "binaries/ffprobe",
          "args": true,
          "sidecar": true
        },
        {
          "name": "ffmpeg-full",
          "cmd": "/opt/homebrew/opt/ffmpeg-full/bin/ffmpeg",
          "args": true,
          "sidecar": false
        },
        {
          "name": "ffprobe-full",
          "cmd": "/opt/homebrew/opt/ffmpeg-full/bin/ffprobe",
          "args": true,
          "sidecar": false
        },
        {
          "name": "ffmpeg-path",
          "cmd": "ffmpeg",
          "args": true,
          "sidecar": false
        },
        {
          "name": "ffmpeg-homebrew",
          "cmd": "/opt/homebrew/bin/ffmpeg",
          "args": true,
          "sidecar": false
        },
        {
          "name": "ffmpeg-usr-local",
          "cmd": "/usr/local/bin/ffmpeg",
          "args": true,
          "sidecar": false
        }
      ]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [
        {
          "path": "/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-rename",
      "allow": [
        {
          "path": "/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-remove",
      "allow": [
        {
          "path": "/**"
        }
      ]
    },
    "notification:default",
    {
      "identifier": "fs:allow-mkdir",
      "allow": [
        {
          "path": "/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [
        {
          "path": "/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [
        {
          "path": "/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-read-file",
      "allow": [
        {
          "path": "/**"
        }
      ]
    }
  ]
}
